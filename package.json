{
  "name": "signal-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cops:pages": "cd collector && python3 -m cops.signal_pages_export --out ../src/data/cops",
    "cops:export": "cd collector && python3 -m cops.dashboard_export --out ../cops-dashboard/public/data",
    "cops:dev": "vite --config cops-dashboard/vite.config.js",
    "cops:build": "vite build --config cops-dashboard/vite.config.js",
    "cops:preview": "vite preview --config cops-dashboard/vite.config.js",
    "push": "npm run build && git add -A && git commit -m \"update\" && git push"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
