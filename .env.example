# Local-only template. Copy to `.env` in the repo root (or export in your shell).
# `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#   # edit .env, then:
#   set -a && source .env && set +a

SUPABASE_URL=https://cdftgybwybuzcyurlccf.supabase.co

# Mode: direct (local debug with service role) | edge (fleet-safe Edge Function)
SIGNAL_UPLOAD_MODE=direct

# Required for direct mode only (never on fleet agents):
SUPABASE_SERVICE_ROLE_KEY=

# Required for edge mode (no service role on the agent):
SIGNAL_INGEST_URL=https://cdftgybwybuzcyurlccf.supabase.co/functions/v1/signal-ingest
SIGNAL_UPLOAD_SECRET=

SIGNAL_DEVICE_ID=pilot-mac-1
# SIGNAL_TENANT_ID=00000000-0000-0000-0000-000000000001
# SIGNAL_TENANT_NAME=Pilot
# SIGNAL_TENANT_DOMAIN=
# SIGNAL_OPERATOR_EMAIL=
# SIGNAL_HOSTNAME=
# SIGNAL_OS=
# SIGNAL_PACKAGE_VERSION=
# SIGNAL_REDACTION_LEVEL=redacted
# SIGNAL_UPLOAD_BATCH_SIZE=100

# ---- COPS LLM interpreter (first_run.py) ----
# Gemini provider (required for first run)
GEMINI_API_KEY=your-key-here
# COPS_GEMINI_MODEL=gemini-2.5-flash

# Anthropic provider (optional second provider)
# ANTHROPIC_API_KEY=your-key-here
# COPS_ANTHROPIC_MODEL=claude-sonnet-4-20250514
